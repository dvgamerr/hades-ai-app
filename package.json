{
  "name": "hades-ai",
  "title": "Hades AI",
  "type": "module",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun x --bun astro dev",
    "serv": "bun ./dist/server/entry.mjs",
    "build:dist": "bun x --bun astro build && bun scripts/build-electron.mjs",
    "lint:fix": "bun x eslint . --fix",
    "format:fix": "bun x prettier . --write",
    "test": "bun x lint-staged && bun x commitlint",
    "prepare": "bun x --bun husky",
    "postinstall": "bun x --bun electron-builder install-app-deps",
    "build:win": "bun run build:dist && bun x --bun electron-builder --win --config",
    "build:mac": "bun run build:dist && bun x --bun electron-builder --mac --config",
    "build:linux": "bun run build:dist && bun x --bun electron-builder --linux --config"
  },
  "lint-staged": {
    "*": "prettier --check . --write",
    "*.{js,mjs,svelte,astro}": "eslint --fix"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@lucide/svelte": "^1.32.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.3",
    "@astrojs/svelte": "^9.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@nurodev/astro-bun": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "astro": "^7.2.3",
    "astro-electron": "^0.5.0",
    "astro-google-fonts-optimizer": "^0.2.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "commitlint": "^21.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.9",
    "svelte-highlight": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-electron": "^1.1.1"
  },
  "svelte": "dist/index.js",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
